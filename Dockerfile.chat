ARG NODE_VERSION=24.13.0
FROM node:${NODE_VERSION}-alpine AS base
WORKDIR /usr/src/app

# Stage: development — runs tsx watch for hot reload
FROM base AS development
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3000
CMD ["npx", "tsx", "watch", "src/chat-server/index.ts"]

# Stage: build — compiles TS to JS for production
FROM base AS build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage: deps — production-only dependencies
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Stage: final — minimal production runtime
FROM base AS final
ENV NODE_ENV=production
USER node
COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/chat-server/index.js"]
